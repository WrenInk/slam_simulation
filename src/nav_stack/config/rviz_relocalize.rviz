Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (orange front)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/Map
      Name: Occupancy map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.85
      Draw Behind: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Real-time scan (10Hz)
      Enabled: true
      Topic:
        Value: /cloud_registered
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 255; 200
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Names: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 16.0
      Pitch: 0.85
      Yaw: 0.8
      Focal Point:
        X: 3.8
        Y: 3.8
        Z: 0.0
      Target Frame: map
Window Geometry:
  Width: 960
  Height: 900
  X: 0
  Y: 50
